<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="tabLukeApp" label="LUKEAPP">

        <!-- GRUPO 1: PROYECTO (GOBERNANZA CENTRALIZADA) -->
        <group id="grpProyecto" label="Proyecto">
          <button
            id="btnProyectoActivo"
            label="Proyecto Activo"
            imageMso="Properties"
            size="large"
            onAction="VerProyectoRibbon"/>
          <button
            id="btnActualizarProyecto"
            label="Actualizar Proyecto"
            imageMso="RefreshAll"
            size="normal"
            onAction="ActualizarProyectoRibbon"/>
          <button
            id="btnCambiarProyecto"
            label="Cambiar Proyecto"
            imageMso="ProjectTask"
            size="normal"
            onAction="CambiarProyectoRibbon"/>
        </group>

        <!-- GRUPO 2: SINCRONIZACION (PUSH / PULL / AUDITORIA) -->
        <group id="grpSync" label="Sincronizacion">
          <button
            id="btnPublicarCambios"
            label="Publicar Cambios"
            imageMso="FileSave"
            size="large"
            onAction="PublicarListaJuntasRibbon"/>
          <button
            id="btnActualizarHoja"
            label="Actualizar Hoja Actual"
            imageMso="Refresh"
            size="large"
            onAction="ActualizarHojaActivaRibbon"/>
          <button
            id="btnActualizarNube"
            label="Actualizar Todo (Nube)"
            imageMso="DataRefreshAll"
            size="normal"
            onAction="ActualizarDesdeNubeRibbon"/>
          <button
            id="btnEstadoSync"
            label="Estado Sincronizacion"
            imageMso="ServerProperties"
            size="normal"
            onAction="VerEstadoSyncRibbon"/>
          <button
            id="btnHistorialSync"
            label="Historial"
            imageMso="History"
            size="normal"
            onAction="VerHistorialSyncRibbon"/>
          <button
            id="btnAuditoriaColumnas"
            label="Auditoria Columnas"
            imageMso="ViewDetails"
            size="normal"
            onAction="AlternarColumnasAuditoriaRibbon"/>
        </group>

        <!-- GRUPO 3: INGENIERIA (LISTAS MAESTRAS DE FAENA) -->
        <group id="grpIngenieria" label="Ingenieria">
          <button
            id="btnIrPID"
            label="P&amp;ID"
            imageMso="Drafts"
            size="normal"
            onAction="IrAPIDRibbon"/>
          <button
            id="btnIrLineas"
            label="Lineas"
            imageMso="TableColumnsInsert"
            size="normal"
            onAction="IrALineasRibbon"/>
          <button
            id="btnIrIsometricos"
            label="Isometricos"
            imageMso="ShapesMoreShapes"
            size="normal"
            onAction="IrAIsometricosRibbon"/>
          <button
            id="btnIrSpools"
            label="Spools"
            imageMso="GroupItems"
            size="normal"
            onAction="IrASpoolsRibbon"/>
          <button
            id="btnIrJuntas"
            label="Juntas"
            imageMso="TableProperties"
            size="large"
            onAction="IrAJuntasRibbon"/>
        </group>

        <!-- GRUPO 4: OPERACION (SEGUIMIENTO Y CONTROL EN TERRENO) -->
        <group id="grpOperacion" label="Operacion">
          <button
            id="btnAvanceProyecto"
            label="Avance Proyecto"
            imageMso="ChartInsert"
            size="normal"
            onAction="VerAvanceRibbon"/>
          <button
            id="btnCalidad"
            label="Calidad"
            imageMso="AcceptTask"
            size="normal"
            onAction="VerCalidadRibbon"/>
          <button
            id="btnLogistica"
            label="Logistica"
            imageMso="DistributionList"
            size="normal"
            onAction="VerLogisticaRibbon"/>
          <button
            id="btnSDI"
            label="SDI / RFI"
            imageMso="DocumentProperties"
            size="normal"
            onAction="VerSdiRibbon"/>
        </group>

        <!-- GRUPO 5: INTELIGENCIA (PANEL, BIM Y BOTS IA) -->
        <group id="grpInteligencia" label="Inteligencia">
          <button
            id="btnDashboard"
            label="Dashboard"
            imageMso="BlogHomePage"
            size="large"
            onAction="AbrirDashboardRibbon"/>
          <button
            id="btnBIMViewer"
            label="BIM Viewer"
            imageMso="WebPage"
            size="normal"
            onAction="AbrirBimViewerRibbon"/>
          <button
            id="btnBotsIA"
            label="Bots IA"
            imageMso="ControlsGallery"
            size="normal"
            onAction="AbrirBotsIaRibbon"/>
        </group>

        <!-- GRUPO 6: SEGURIDAD Y ACCESO -->
        <group id="grpSeguridad" label="Seguridad">
          <button
            id="btnIniciarSesion"
            label="Iniciar Sesion"
            imageMso="Key"
            size="large"
            onAction="IniciarSesionRibbon"/>
          <button
            id="btnCerrarSesion"
            label="Cerrar Sesion"
            imageMso="Close"
            size="normal"
            onAction="CerrarSesionLukeAppRibbon"/>
          <button
            id="btnSolicitarAcceso"
            label="Solicitar Acceso"
            imageMso="ContactCard"
            size="normal"
            onAction="SolicitarAccesoRibbon"/>
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
