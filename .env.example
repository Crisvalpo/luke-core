# ==============================================================================
# LUKE CORE - VARIABLES DE ENTORNO
# ==============================================================================

# Configuración del Servidor
PORT=3080
NODE_ENV=development
APP_NAME=luke-core

# Base de Datos PostgreSQL / Supabase
# Para entorno local o desarrollo:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Para Oracle Server (Supabase Docker interno):
# DATABASE_URL=postgresql://postgres:su_password_aqui@127.0.0.1:5432/postgres

# Seguridad & Claves de API
CORE_ADMIN_API_KEY=luke-core-secret-admin-key-2026
JWT_SECRET=super-secret-jwt-key-for-luke-core

# Configuración de CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3080,https://lukeapp.cl,https://andina.lukeapp.cl
